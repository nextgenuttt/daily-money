    <string name="sms_disclosure_title">Read your bank SMS?</string>
    <string name="sms_disclosure_what">Daily Money will read SMS from banks and UPI services (sender IDs like AX-HDFCBK) to find payments: amount, debit or credit, who was paid, date and the last digits of the account.</string>
    <string name="sms_disclosure_skip">Messages from people, OTPs and offers are skipped. The message text is not stored; only the payment details are kept, and you choose what to add.</string>
    <string name="sms_disclosure_where">Everything happens on this phone. Your messages are never uploaded or shared.</string>
    <string name="sms_disclosure_off">You can turn this off any time here, or remove the permission in phone settings.</string>
