<?xml version="1.0" encoding="utf-8"?>
<!--
  Only in the "smsReader" build. Bank SMS are read on the phone after the user turns on
  Settings → Find payments in bank SMS; nothing is uploaded. Needs Play's SMS permission approval.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Phones without a SIM (tablets, Chromebooks) can still install the app; the switch just finds nothing. -->
    <uses-feature android:name="android.hardware.telephony" android:required="false" />

    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.READ_SMS" />

    <application>
        <receiver
            android:name="com.dailymoney.core.data.smart.SmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
